---
import SiteLayout from "../layouts/site-layout.astro";
import SiteHeader from "../components/sections/site-header.astro";
import HeroSection from "../components/sections/hero-section.astro";
import ServicesSection from "../components/sections/services-section.astro";
import ProcessSection from "../components/sections/process-section.astro";
import { pageContent } from "../data/content";
---

<SiteLayout title={pageContent.seo.title} description={pageContent.seo.description}>
  <SiteHeader />
  <main id="main-content" tabindex="-1">
    <HeroSection />
    <ServicesSection />
    <ProcessSection />
  </main>
</SiteLayout>

---
import SiteLayout from "../layouts/site-layout.astro";
import PageContainer from "../components/ui/page-container.astro";
import SectionHeading from "../components/ui/section-heading.astro";
import { pageContent } from "../data/content";
---

<SiteLayout title={pageContent.seo.title} description={pageContent.seo.description}>
  <main id="main-content" tabindex="-1" class="flex min-h-screen items-center py-section">
    <PageContainer>
      <SectionHeading
        headingLevel={1}
        eyebrow="Estrutura inicial"
        title="Astro + Tailwind CSS prontos"
        description="Página placeholder para demonstrar a fundação do projeto. O conteúdo institucional será desenvolvido em uma próxima etapa."
      />
    </PageContainer>
  </main>
</SiteLayout>

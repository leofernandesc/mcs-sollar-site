---
import { Image } from "astro:assets";
import projectPlan from "../../assets/images/services/photovoltaic-project-plan.webp";
import installationMeasurement from "../../assets/images/services/installation-measurement.jpeg";
import inverterMaintenance from "../../assets/images/services/inverter-maintenance.webp";
import { pageContent } from "../../data/content";
import PageContainer from "../ui/page-container.astro";
import SectionHeading from "../ui/section-heading.astro";

const services = [
  { ...pageContent.services[0], image: projectPlan },
  { ...pageContent.services[1], image: installationMeasurement },
  { ...pageContent.services[2], image: inverterMaintenance },
];
---

<section
  id="servicos"
  aria-labelledby="services-heading"
  class="border-t border-brand-navy/10 bg-white py-section"
>
  <PageContainer>
    <div class="space-y-10 sm:space-y-12">
      <SectionHeading
        id="services-heading"
        title="Serviços"
        description={pageContent.servicesDescription}
      />

      <ul class="grid gap-x-8 gap-y-8 md:grid-cols-3">
        {services.map((service, index) => (
          <li class="border-t border-brand-navy/20 pt-5">
            <article>
              <h3 class="text-xl sm:text-2xl">{service.title}</h3>
              <p class="mt-3 max-w-md text-base leading-7 text-ink md:min-h-28 lg:min-h-[5.25rem] xl:min-h-14">
                {service.description}
              </p>
              <figure class="mt-6">
                <div
                  class:list={[
                    "overflow-hidden rounded-md",
                    index === 0 && "md:aspect-[1.8]",
                  ]}
                >
                  <Image
                    src={service.image}
                    alt={service.imageAlt}
                    widths={[320, 480, 640, 800]}
                    sizes="(min-width: 48rem) 30vw, calc(100vw - 2rem)"
                    format="webp"
                    quality={84}
                    loading="lazy"
                    decoding="async"
                    class:list={[
                      "h-auto w-full",
                      index === 0 && "md:h-full md:object-cover",
                    ]}
                  />
                </div>
                <figcaption class="mt-3 text-sm leading-6 text-ink/80">
                  {service.imageCaption}
                </figcaption>
              </figure>
              {index === 0 && (
                <figure class="mt-5">
                  <div class="aspect-video overflow-hidden rounded-md border border-brand-navy/10 bg-brand-navy/5">
                    <video
                      class="block h-full w-full object-cover"
                      controls
                      muted
                      playsinline
                      preload="none"
                      poster="/images/mcs-sollar-carregamento-veicular-poster.webp"
                      aria-label="Vídeo de carregamento veicular"
                    >
                      <source
                        src="/videos/mcs-sollar-carregamento-veicular.mp4"
                        type="video/mp4"
                      />
                      Seu navegador não oferece suporte à reprodução deste vídeo.
                    </video>
                  </div>
                  <figcaption class="mt-3 text-sm leading-6 text-ink/80">
                    Registro em vídeo de carregamento veicular.
                  </figcaption>
                </figure>
              )}
            </article>
          </li>
        ))}
      </ul>
    </div>
  </PageContainer>
</section>

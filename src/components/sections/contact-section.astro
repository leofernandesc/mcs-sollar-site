---
import { business } from "../../data/business";
import { pageContent } from "../../data/content";
import PageContainer from "../ui/page-container.astro";
import SectionHeading from "../ui/section-heading.astro";
import WhatsAppLink from "../ui/whatsapp-link.astro";
---

<section
  id="contato"
  aria-labelledby="contact-heading"
  class="border-t border-brand-navy/10 bg-brand-cream py-section"
>
  <PageContainer>
    <div class="grid gap-8 md:grid-cols-12 md:items-center md:gap-10">
      <div class="md:col-span-7">
        <SectionHeading
          id="contact-heading"
          eyebrow={business.locationDisplay}
          title={pageContent.contact.title}
          description={pageContent.contact.description}
        />
      </div>

      <div class="md:col-span-5 xl:justify-self-end">
        <WhatsAppLink
          intent="quote"
          label={pageContent.hero.quotationLabel}
        />
      </div>
    </div>
  </PageContainer>
</section>

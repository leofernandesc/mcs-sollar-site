---
import { Image } from "astro:assets";
import residentialRooftop from "../../assets/images/projects/residential-rooftop.webp";
import ceramicRoofPanels from "../../assets/images/projects/ceramic-roof-panels.webp";
import groundMountedArray from "../../assets/images/projects/ground-mounted-array.webp";
import { pageContent } from "../../data/content";
import PageContainer from "../ui/page-container.astro";
import SectionHeading from "../ui/section-heading.astro";

const projects = [
  { ...pageContent.projects.items[0], image: residentialRooftop },
  { ...pageContent.projects.items[1], image: ceramicRoofPanels },
  { ...pageContent.projects.items[2], image: groundMountedArray },
];
---

<section
  id="projetos"
  aria-labelledby="projects-heading"
  class="border-t border-brand-navy/10 bg-brand-cream py-section"
>
  <PageContainer>
    <div class="space-y-10 sm:space-y-12">
      <SectionHeading
        id="projects-heading"
        title={pageContent.projects.title}
        description={pageContent.projects.description}
      />

      <ul class="grid gap-7 md:grid-cols-3">
        {projects.map((project) => (
          <li>
            <figure>
              <div class="aspect-video overflow-hidden rounded-lg border border-brand-navy/10 bg-white">
                <Image
                  src={project.image}
                  alt={project.alt}
                  widths={[320, 480, 640, 800, 960]}
                  sizes="(min-width: 80rem) 24rem, (min-width: 48rem) 30vw, calc(100vw - 2rem)"
                  format="webp"
                  quality={82}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover"
                />
              </div>
              <figcaption class="mt-3 text-sm leading-6 text-ink">
                {project.caption}
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </PageContainer>
</section>

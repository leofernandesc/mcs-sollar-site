---
import { Image } from "astro:assets";
import inverterInstallation from "../../assets/images/hero/solar-inverter-installation.webp";
import electricalSafetySign from "../../assets/images/services/electrical-safety-sign.webp";
import evChargingInstallation from "../../assets/images/about/solar-installation-ev-charger.webp";
import monitoringApp from "../../assets/images/about/solar-monitoring-app.webp";
import { business } from "../../data/business";
import { pageContent } from "../../data/content";
import PageContainer from "../ui/page-container.astro";
import SectionHeading from "../ui/section-heading.astro";
---

<section
  id="sobre"
  aria-labelledby="about-heading"
  class="border-t border-brand-navy/10 bg-white py-section"
>
  <PageContainer>
    <div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr] lg:items-start lg:gap-12">
      <div>
        <SectionHeading
          id="about-heading"
          eyebrow={business.locationDisplay}
          title={pageContent.about.title}
        />
      </div>

      <div class="max-w-2xl lg:pb-1">
        <p class="text-xl font-medium leading-8 text-brand-navy sm:text-2xl sm:leading-9">
          {pageContent.about.lead}
        </p>
        <p class="mt-4 text-base leading-7 text-ink sm:text-lg sm:leading-8">
          {pageContent.about.description}
        </p>
      </div>
    </div>

    <div class="mt-8 grid min-w-0 grid-cols-2 items-start gap-x-3 gap-y-6 sm:gap-x-5 sm:gap-y-8 lg:mt-10 lg:grid-cols-4">
      <figure class="min-w-0 lg:col-span-2">
        <div class="overflow-hidden rounded-md">
          <Image
            src={evChargingInstallation}
            alt={pageContent.about.evChargingImageAlt}
            widths={[360, 540, 720, 960]}
            sizes="(min-width: 64rem) 42vw, 45vw"
            format="webp"
            quality={84}
            loading="lazy"
            decoding="async"
            class="h-auto w-full"
          />
        </div>
        <figcaption class="mt-2 text-xs leading-5 text-ink/80 sm:mt-3 sm:text-sm sm:leading-6">
          {pageContent.about.evChargingImageCaption}
        </figcaption>
      </figure>

      <figure class="min-w-0 lg:col-span-2">
        <div class="overflow-hidden rounded-md">
          <Image
            src={inverterInstallation}
            alt={pageContent.about.inverterImageAlt}
            widths={[360, 540, 720, 960]}
            sizes="(min-width: 64rem) 42vw, 45vw"
            format="webp"
            quality={84}
            loading="lazy"
            decoding="async"
            class="h-auto w-full"
          />
        </div>
        <figcaption class="mt-2 text-xs leading-5 text-ink/80 sm:mt-3 sm:text-sm sm:leading-6">
          {pageContent.about.inverterImageCaption}
        </figcaption>
      </figure>

      <figure class="min-w-0 lg:col-start-2">
        <div class="flex h-64 justify-center overflow-hidden rounded-md sm:h-72 lg:h-80">
          <Image
            src={electricalSafetySign}
            alt={pageContent.about.safetyImageAlt}
            widths={[192, 256, 384, 480]}
            sizes="(min-width: 64rem) 15rem, (min-width: 48rem) 14rem, 45vw"
            format="webp"
            quality={84}
            loading="lazy"
            decoding="async"
            class="h-auto max-h-full w-auto max-w-full"
          />
        </div>
        <figcaption class="mt-2 text-xs leading-5 text-ink/80 sm:mt-3 sm:text-sm sm:leading-6">
          {pageContent.about.safetyImageCaption}
        </figcaption>
      </figure>

      <figure class="min-w-0 lg:col-start-3">
        <div class="flex h-64 justify-center overflow-hidden rounded-md sm:h-72 lg:h-80">
          <Image
            src={monitoringApp}
            alt={pageContent.about.monitoringImageAlt}
            widths={[144, 192, 256, 384, 480]}
            sizes="(min-width: 64rem) 9rem, (min-width: 48rem) 8rem, 45vw"
            format="webp"
            quality={84}
            loading="lazy"
            decoding="async"
            class="h-auto max-h-full w-auto max-w-full"
          />
        </div>
        <figcaption class="mt-2 text-xs leading-5 text-ink/80 sm:mt-3 sm:text-sm sm:leading-6">
          {pageContent.about.monitoringImageCaption}
        </figcaption>
      </figure>
    </div>
  </PageContainer>
</section>

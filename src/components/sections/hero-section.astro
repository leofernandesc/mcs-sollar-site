---
import { Image } from "astro:assets";
import heroImage from "../../assets/images/solar-panels-illustrative.webp";
import { pageContent } from "../../data/content";
import PageContainer from "../ui/page-container.astro";
import SectionHeading from "../ui/section-heading.astro";
import WhatsAppLink from "../ui/whatsapp-link.astro";

// Photo by Michael Roberts / Unsplash, used under the Unsplash License.
const imageCreditUrl = "https://unsplash.com/photos/a-solar-panel-on-the-roof-of-a-house-U0ys6tX7UMU";
---

<section
  id="inicio"
  aria-labelledby="hero-title"
  class="bg-brand-cream py-section"
>
  <PageContainer>
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
      <div class="max-w-2xl">
        <SectionHeading
          id="hero-title"
          headingLevel={1}
          title={pageContent.hero.title}
          description={pageContent.hero.description}
        />

        <div class="mt-7 flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:gap-5">
          <WhatsAppLink
            intent="quote"
            label={pageContent.hero.quotationLabel}
          />
          <a
            href="#servicos"
            class="inline-flex min-h-11 items-center font-semibold text-brand-navy underline decoration-brand-navy/40 underline-offset-4 hover:decoration-brand-navy"
          >
            {pageContent.hero.servicesLabel}
          </a>
        </div>
      </div>

      <figure class="min-w-0">
        <div class="aspect-[4/3] overflow-hidden rounded-lg border border-brand-navy/10 bg-white">
          <Image
            src={heroImage}
            alt="Painéis solares instalados no telhado de uma residência."
            widths={[384, 640, 960, 1280]}
            sizes="(min-width: 80rem) 38rem, (min-width: 64rem) 45vw, calc(100vw - 2rem)"
            format="webp"
            quality={82}
            loading="eager"
            fetchpriority="high"
            class="h-full w-full object-cover"
          />
        </div>
        <figcaption class="mt-3 text-sm leading-6 text-ink/80">
          Imagem ilustrativa. Foto por{" "}
          <a href={imageCreditUrl} class="font-medium text-brand-navy underline underline-offset-2">
            Michael Roberts / Unsplash
          </a>.
        </figcaption>
      </figure>
    </div>
  </PageContainer>
</section>

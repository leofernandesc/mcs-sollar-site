---
import { business } from "../../data/business";

interface Props {
  variant?: "header" | "footer";
}

const { variant = "header" } = Astro.props;
const variantClasses = {
  header: "border-brand-navy text-brand-navy hover:bg-white/60",
  footer: "instagram-link-footer border-white/60 text-white hover:bg-white/10",
}[variant];
---

<a
  href={business.instagram.url}
  aria-label={`Instagram da ${business.name}`}
  class:list={[
    "inline-flex min-h-11 items-center justify-center gap-2 whitespace-nowrap rounded-md border px-3 py-3 text-sm font-semibold transition-colors",
    variantClasses,
  ]}
>
  <svg
    viewBox="0 0 24 24"
    class="h-[18px] w-[18px] shrink-0"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="3" y="3" width="18" height="18" rx="5" />
    <circle cx="12" cy="12" r="4" />
    <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
  </svg>
  Instagram
</a>

<style>
  .instagram-link-footer:focus-visible {
    outline-color: var(--color-brand-cream);
  }
</style>
